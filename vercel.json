{
  "buildCommand": "npm run build",
  "outputDirectory": ".",
  "cleanUrls": true,
  "trailingSlash": false,
  "redirects": [
    {
      "source": "/:path*",
      "has": [{ "type": "host", "value": "www.paraffine.studio" }],
      "destination": "https://paraffine.studio/:path*",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/",
      "has": [{ "type": "host", "value": "tools.paraffine.studio" }],
      "destination": "/tools.html"
    },
    {
      "source": "/((?!tools).*)",
      "has": [{ "type": "host", "value": "tools.paraffine.studio" }],
      "destination": "/tools.html"
    }
  ]
}
